<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration — CycleCare
    Play Store Requirement: No cleartext traffic in production.
    Only HTTPS connections are permitted.
    Localhost (127.0.0.1) allowed for local asset loading via WebViewAssetLoader.
-->
<network-security-config>
    <!-- Block all cleartext (HTTP) traffic by default -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust system CA store -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Allow localhost for WebViewAssetLoader asset serving -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Google Fonts CDN (already HTTPS) -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">fonts.googleapis.com</domain>
        <domain includeSubdomains="true">fonts.gstatic.com</domain>
        <domain includeSubdomains="true">cdn.jsdelivr.net</domain>
    </domain-config>
</network-security-config>
